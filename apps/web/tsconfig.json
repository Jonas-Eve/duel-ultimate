{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "allowJs": true
  },
  "include": ["src", "tests", "vite", "vite.config.ts", "e2e", "playwright.config.ts"]
}
